<!DOCTYPE html>
<html lang="ka">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NEXVOLT</title>

  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #111;
      color: white;
    }

    header {
      padding: 25px;
      text-align: center;
      background: #181818;
    }

    header h1 {
      margin: 0;
    }

    .products {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
      padding: 25px;
    }

    .card {
      background: #1d1d1d;
      border-radius: 15px;
      padding: 15px;
      text-align: center;
    }

    .card img {
      width: 100%;
      height: 180px;
      object-fit: contain;
    }

    .price {
      font-size: 22px;
      font-weight: bold;
      margin: 10px;
    }

    button {
      border: none;
      padding: 12px 20px;
      border-radius: 10px;
      cursor: pointer;
      font-weight: bold;
    }
  </style>
</head>

<body>

<header>
  <h1>🎮 NEXVOLT</h1>
  <p>Gaming Gear Store</p>
</header>

<section class="products">

  <div class="card">
    <img src="https://via.placeholder.com/300x200">
    <h2>Gaming Keyboard</h2>
    <p class="price">90₾</p>
    <button>Buy Now</button>
  </div>

  <div class="card">
    <img src="https://via.placeholder.com/300x200">
    <h2>Gaming Mouse</h2>
    <p class="price">30₾</p>
    <button>Buy Now</button>
  </div>

  <div class="card">
    <img src="https://via.placeholder.com/300x200">
    <h2>Gaming Headset</h2>
    <p class="price">50₾</p>
    <button>Buy Now</button>
  </div>

</section>

</body>
</html>
